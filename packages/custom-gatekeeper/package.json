{
  "name": "custom-gatekeeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "pnpm run build:app && tsc",
    "build:app": "node scripts/build-app.mjs",
    "lint": "tsc --noEmit",
    "types:check": "tsc --noEmit",
    "test": "tsc && node --test __tests__/*.node.test.mjs",
    "test:worker": "vitest run --config vitest.config.ts",
    "preview": "tsc && node scripts/preview-ui.mjs"
  },
  "dependencies": {
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "^0.8.0",
    "capnweb-validate": "0.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
